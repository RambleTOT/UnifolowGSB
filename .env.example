# --- Приложение ---------------------------------------------------------------
UNIFLOW_ENV=local
UNIFLOW_HOST=127.0.0.1
UNIFLOW_PORT=8000
# Ключ подписи сессионной cookie. Для сервера обязательно заменить.
UNIFLOW_SECRET_KEY=change-me-please
# Часовой пояс объекта: в нём считаются сутки и показывается время.
UNIFLOW_TIMEZONE=Europe/Moscow

# --- Первая учётная запись ----------------------------------------------------
# Создаётся при первом старте. Если пароль не задан, он генерируется случайно
# и печатается в консоль один раз — сохраните его.
UNIFLOW_ADMIN_LOGIN=admin
UNIFLOW_ADMIN_PASSWORD=

# --- Данные -------------------------------------------------------------------
UNIFLOW_DATABASE_URL=sqlite:///./data/uniflow.db
UNIFLOW_VIDEO_DIR=./data/videos
UNIFLOW_SNAPSHOT_DIR=./data/snapshots
UNIFLOW_CACHE_DIR=./data/cache
UNIFLOW_MAX_UPLOAD_MB=512

# --- Анализ -------------------------------------------------------------------
# auto подбирает устройство: CUDA → MPS → CPU.
UNIFLOW_DEVICE=auto
# auto измеряет скорость и выбирает между анализом в реальном времени и предрасчётом.
UNIFLOW_ANALYSIS_MODE=auto
# fast | standard | accurate
UNIFLOW_MODEL_PROFILE=standard
UNIFLOW_CONFIDENCE=0.25
UNIFLOW_TRACKER=bytetrack.yaml
UNIFLOW_AGGREGATION_SECONDS=5
UNIFLOW_RETENTION_DAYS=30

# --- Пороги событий (значения по умолчанию, меняются в Настройках) ------------
UNIFLOW_QUEUE_THRESHOLD=10
UNIFLOW_WAIT_THRESHOLD_MINUTES=5
UNIFLOW_CHECKPOINT_THRESHOLD_PER_MINUTE=25
UNIFLOW_EVENT_MIN_DURATION_SECONDS=15
UNIFLOW_SAVE_EVENT_SNAPSHOTS=true
